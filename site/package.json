{
  "name": "rekurt-portfolio-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "npm run check --workspace @rekurt/article-demos && astro check && ./node_modules/typescript-native/bin/tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build --workspace @rekurt/article-demos && astro build",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.4",
    "eslint": "^10.12.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "typescript-native": "npm:typescript@~7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "workspaces": [
    "examples/chart-articles"
  ]
}
