---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Content } from "../../content/articles/prt-0-6-0.md";
const title = "prt 0.6.0: find the process behind a local port";
const description = "A reproducible macOS port-ownership check with prt 0.6.0, a JSON snapshot and lsof, with clear validation limits and installation commands.";
const path = "/articles/prt-0-6-0-port-ownership/";
const schema = {
  "@context": "https://schema.org", "@type": "TechArticle",
  headline: title, description, url: `https://rekurt.github.io${path}`,
  datePublished: "2026-10-15", inLanguage: "en",
  author: { "@type": "Person", name: "Nikita", url: "https://github.com/rekurt" },
};
---
<BaseLayout title={title} description={description} locale="en" canonicalPath={path} alternateLocales={false} socialSlug="prt" jsonLd={schema}>
  <article class="technical-article">
    <p class="eyebrow">Technical walkthrough · <time datetime="2026-10-15">15 October 2026</time></p>
    <Content />
    <p><a href="/projects/prt/">Explore prt</a> · <a href="/articles/">All articles</a></p>
  </article>
</BaseLayout>
<style>
  .technical-article { max-width: 76ch; margin-inline: auto; overflow-wrap: anywhere; }
  .technical-article :global(h1) { max-width: 25ch; margin-bottom: 1.5rem; }
  .technical-article :global(h2) { margin-top: 2.5rem; margin-bottom: 1rem; }
  .technical-article :global(pre) { max-width: 100%; overflow-x: auto; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); }
</style>
