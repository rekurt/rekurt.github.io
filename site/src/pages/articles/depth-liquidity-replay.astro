---
import { readFileSync } from "node:fs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Content as Intro } from "../../content/articles/depth-liquidity-intro.md";
import { Content } from "../../content/articles/depth-liquidity.md";
const title = "Depth: what happens when liquidity disappears";
const description = "Add a large ask, remove nearby orders and compare spread, volume and imbalance in a working depth chart.";
const path = "/articles/depth-liquidity-replay/";
const examples = [{"name": "Depth example", "path": "depth/", "file": "depth.ts"}, {"name": "Sample data and parsing", "path": "depth/", "file": "model.ts"}].map(example => ({...example, source: readFileSync(new URL(`../../../examples/chart-articles/src/${example.file}`, import.meta.url), "utf8")}));
const schema = {
  "@context": "https://schema.org", "@type": "TechArticle",
  headline: title, description, url: `https://rekurt.github.io${path}`,
  datePublished: "2026-10-15", inLanguage: "en",
  author: { "@type": "Person", name: "Nikita", url: "https://github.com/rekurt" },
};
---
<BaseLayout title={title} description={description} locale="en" canonicalPath={path} alternateLocales={false} socialSlug="depth" jsonLd={schema}>
  <article class="technical-article">
    <p class="eyebrow">Technical walkthrough · <time datetime="2026-10-15">15 October 2026</time></p>
    <Intro />
<section class="demo"><h2>Try the depth chart</h2><iframe title="Depth lab interactive chart" src="/article-demos/depth/" loading="lazy"></iframe><p><a href="/article-demos/depth/" target="_blank" rel="noopener">Open demo in a full window</a></p></section>
<figure><img src="/images/articles/depth-liquidity.png" alt="Synthetic book after near-touch levels disappear: the spread widens from 2 to 6." loading="lazy" width="1440" height="1000" /><figcaption>Synthetic book after near-touch levels disappear: the spread widens from 2 to 6.</figcaption></figure>
<Content />
<section><h2>Example code</h2>{examples.map(example => <details><summary>{example.name} · {example.file}</summary><p><a href={`https://github.com/rekurt/rekurt.github.io/blob/main/site/examples/chart-articles/src/${example.file}`}>View {example.file} in the repository</a></p><pre><code class={example.file.endsWith("tsx") ? "language-typescript" : "language-typescript"}>{example.source}</code></pre></details>)}</section>
    <p><a href="/projects/depth/">Explore depth</a> · <a href="/articles/">All articles</a></p>
  </article>
</BaseLayout>
<script>import { attachChartHeight } from "../../lib/article-embed"; attachChartHeight();</script>
<style>
  .technical-article { max-width: 76ch; margin-inline: auto; overflow-wrap: anywhere; }
  .technical-article :global(h1) { max-width: 25ch; margin-bottom: 1.5rem; }
  .technical-article :global(h2) { margin-top: 2.5rem; margin-bottom: 1rem; }
  .technical-article :global(pre) { max-width: 100%; overflow-x: auto; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); }
  details { margin-block: 1rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); }
  summary { cursor: pointer; font-weight: 600; }
  figure { margin: 2rem 0; }
  img { display: block; width: 100%; height: auto; border-radius: var(--radius); }
  figcaption { font-size: .9rem; margin-top: .5rem; }
  iframe { width: 100%; height: 890px; border: 1px solid var(--border); border-radius: var(--radius); }
  .demo { margin-block: 2rem; }
  @media (max-width: 650px) { iframe { height: 1340px; } }
</style>
