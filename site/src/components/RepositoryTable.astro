---
import type { Copy } from "../i18n/copy";
import type { Repository } from "../lib/catalog";

interface Props { repositories: Repository[]; t: Copy; locale: "en" | "ru" }
const { repositories, t, locale } = Astro.props;
const roleLabels: Record<string, string> = {
  primary: t.rolePrimary,
  support: t.roleSupport,
  "maintained-fork": t.roleMaintainedFork,
  fork: t.roleFork,
  "portfolio-hub": t.rolePortfolioHub,
  unclassified: t.roleUnclassified,
};
const date = new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeZone: "UTC" });
---

<div class="registry-shell">
  <table class="repository-table">
    <thead>
      <tr>
        <th>{t.registryRepository}</th><th>{t.registryRole}</th><th>{t.registryOrigin}</th>
        <th>{t.registryLanguage}</th><th>{t.registryVersion}</th><th>{t.registryLinks}</th><th>{t.registryLastPush}</th>
      </tr>
    </thead>
    <tbody>
      {repositories.map((repository) => {
        const publicLinks = repository.links.filter((link) => link.kind === "website" || link.kind === "documentation");
        return (
          <tr>
            <td data-label={t.registryRepository}><a href={repository.url} target="_blank" rel="noreferrer">{repository.name}</a></td>
            <td data-label={t.registryRole}><span class={`role role-${repository.role}`}>{roleLabels[repository.role] ?? t.roleUnclassified}</span></td>
            <td data-label={t.registryOrigin}>{repository.parent ? <a href={`https://github.com/${repository.parent}`} target="_blank" rel="noreferrer">{repository.parent}</a> : t.originOriginal}</td>
            <td data-label={t.registryLanguage}>{repository.language ?? "—"}</td>
            <td data-label={t.registryVersion}>{repository.version?.value ?? "—"}</td>
            <td data-label={t.registryLinks}>
              {publicLinks.length ? publicLinks.map((link) => <a class="compact-link" href={link.url} target="_blank" rel="noreferrer">{link.kind === "website" ? t.linkWebsite : t.linkDocumentation}</a>) : <span class="empty-value">{t.noPublicSurface}</span>}
            </td>
            <td data-label={t.registryLastPush}><time datetime={repository.pushedAt}>{date.format(new Date(repository.pushedAt))}</time></td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
