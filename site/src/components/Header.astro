---
import { alternatePath, copy, localePrefix } from "../i18n/copy";
import type { Locale } from "../lib/catalog";

interface Props { locale: Locale; currentPath: string; showLanguage?: boolean }
const { locale, currentPath, showLanguage = true } = Astro.props;
const t = copy[locale];
const prefix = localePrefix(locale);
const links = [
  { href: `${prefix}/projects/`, label: t.navProjects },
  { href: `${prefix}/registry/`, label: t.navRegistry },
  { href: `${prefix}/about/`, label: t.navAbout },
];
const normalizedPath = currentPath.endsWith("/") ? currentPath : `${currentPath}/`;
const localeLinks: Array<{ locale: Locale; lang: string; label: string }> = [
  { locale: "en", lang: "en", label: t.languageEnglish },
  { locale: "ru", lang: "ru", label: t.languageRussian },
  { locale: "zh-cn", lang: "zh-CN", label: t.languageChinese },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={`${prefix}/`}>
      <span class="brand-mark" aria-hidden="true">R</span>
      <span>{t.siteName}</span>
    </a>
    <nav class="site-nav" aria-label={t.primaryNavigation}>
      {links.map((link) => (
        <a href={link.href} aria-current={normalizedPath.startsWith(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
      {showLanguage && localeLinks.map((link) => <a class="language-link" href={alternatePath(currentPath, link.locale)} hreflang={link.lang} aria-current={link.locale === locale ? "page" : undefined}>{link.label}</a>)}
    </nav>
  </div>
</header>
