---
import AuthorIntro from "../components/AuthorIntro.astro";
import { author } from "../lib/author";
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy, localePrefix } from "../i18n/copy";
import { getCatalog, type Locale } from "../lib/catalog";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const catalog = getCatalog();
const canonicalPath = `${localePrefix(locale)}/about/`;
const schema = { "@context": "https://schema.org", "@type": "Person", name: "rekurt", url: "https://rekurt.github.io/", sameAs: [author.profileUrl], image: author.avatarUrl };
---

<BaseLayout title={`${t.navAbout} — rekurt`} description={t.aboutIntro} locale={locale} canonicalPath={canonicalPath} syncedAt={catalog.syncedAt} jsonLd={schema}>
  <header class="page-intro">
    <p class="eyebrow">{t.aboutEyebrow}</p>
    <h1>{t.aboutTitle}</h1>
  </header>
  <AuthorIntro locale={locale} />
  <section class="section" aria-label={t.navProjects}>
    <h2>{t.featuredProjects}</h2>
    <p class="section-description">{t.projectsIntro}</p>
    <a class="primary-button" href={`${localePrefix(locale)}/projects/`}>{t.browseProjects} <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
