---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { alternatePath, copy } from "../i18n/copy";
import type { Locale } from "../lib/catalog";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  syncedAt?: string;
  jsonLd?: Record<string, unknown>;
  alternateLocales?: boolean;
}

const { title, description, locale, canonicalPath, syncedAt, jsonLd, alternateLocales = true } = Astro.props;
const t = copy[locale];
const canonical = new URL(canonicalPath, Astro.site);
const english = new URL(alternatePath(canonicalPath, "en"), Astro.site);
const russian = new URL(alternatePath(canonicalPath, "ru"), Astro.site);
const chinese = new URL(alternatePath(canonicalPath, "zh-cn"), Astro.site);
const ogLocales = { en: "en_US", ru: "ru_RU", "zh-cn": "zh_CN" } as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b10" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternateLocales && <link rel="alternate" hreflang="en" href={english} />}
    {alternateLocales && <link rel="alternate" hreflang="ru" href={russian} />}
    {alternateLocales && <link rel="alternate" hreflang="zh-CN" href={chinese} />}
    {alternateLocales && <link rel="alternate" hreflang="x-default" href={english} />}
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skipToContent}</a>
    <Header locale={locale} currentPath={canonicalPath} showLanguage={alternateLocales} />
    <main id="content" class="container page-shell">
      <slot />
    </main>
    <Footer locale={locale} syncedAt={syncedAt} />
  </body>
</html>
