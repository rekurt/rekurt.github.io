---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { alternatePath, copy } from "../i18n/copy";
import { author } from "../lib/author";
import type { Locale } from "../lib/catalog";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  syncedAt?: string;
  jsonLd?: Record<string, unknown>;
  alternateLocales?: boolean;
  noindex?: boolean;
  socialSlug?: string;
}

const { title, description, locale, canonicalPath, syncedAt, jsonLd, alternateLocales = true, noindex = false, socialSlug = "rekurt" } = Astro.props;
const t = copy[locale];
const canonical = new URL(canonicalPath, Astro.site);
const english = new URL(alternatePath(canonicalPath, "en"), Astro.site);
const russian = new URL(alternatePath(canonicalPath, "ru"), Astro.site);
const chinese = new URL(alternatePath(canonicalPath, "zh-cn"), Astro.site);
const pageSchema = {
  "@context": "https://schema.org", "@type": "WebPage", "@id": `${canonical}#webpage`,
  url: String(canonical), name: title, description, inLanguage: locale,
  isPartOf: { "@type": "WebSite", "@id": "https://rekurt.github.io/#website", name: "rekurt", url: "https://rekurt.github.io/" },
  author: { "@type": "Person", "@id": "https://rekurt.github.io/#author", name: "rekurt", url: author.profileUrl },
};
const serialize = (data: unknown) => JSON.stringify(data).replaceAll("<", "\\u003c");
const socialImage = new URL(`/social/${socialSlug}.png`, Astro.site);
const ogLocales = { en: "en_US", ru: "ru_RU", "zh-cn": "zh_CN" } as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#080b10" />
    <meta property="og:site_name" content="rekurt" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternateLocales && <link rel="alternate" hreflang="en" href={english} />}
    {alternateLocales && <link rel="alternate" hreflang="ru" href={russian} />}
    {alternateLocales && <link rel="alternate" hreflang="zh-CN" href={chinese} />}
    {alternateLocales && <link rel="alternate" hreflang="x-default" href={english} />}
    <link rel="stylesheet" href="/syntax/syntax.css?v=11.12.0-1" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" data-page-schema set:html={serialize(pageSchema)} />
    {jsonLd && <script is:inline type="application/ld+json" data-content-schema set:html={serialize(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skipToContent}</a>
    <Header locale={locale} currentPath={canonicalPath} showLanguage={alternateLocales} />
    <main id="content" class="container page-shell">
      <slot />
    </main>
    <Footer locale={locale} syncedAt={syncedAt} />
    <script is:inline src="/syntax/highlight-11.12.0.min.js" defer></script>
    <script is:inline src="/syntax/syntax.js?v=11.12.0-1" defer></script>
  </body>
</html>
